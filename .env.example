# Copy to .env and adjust. Existing environment variables take precedence.
PORT=3000
# Public URL of the voting website — used as the voting link in invitation emails.
PUBLIC_BASE_URL=https://vote.example.org
# Set to true when served over HTTPS (marks cookies Secure, enables HSTS).
SECURE_COOKIES=false
# Set to true when running behind a reverse proxy (nginx, Caddy, load balancer).
TRUST_PROXY=false
# Where the SQLite database and uploaded photos are stored. Back this directory up.
DATA_DIR=./data

# First-run Main Administrator (only used when no admin exists yet).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# SMTP for invitation emails. If SMTP_HOST is empty, emails are stored in the
# admin "Email outbox" instead of being sent (useful for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MANAGE Alumni Association Elections <elections@example.org>"
SMTP_REPLY_TO=
MAIL_RATE_PER_MINUTE=120
