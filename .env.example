# Copy to .env and adjust. Existing environment variables take precedence.
PORT=3000
# Public URL of the voting website — used as the voting link in invitation emails.
PUBLIC_BASE_URL=https://vote.example.org
# Set to true when served over HTTPS (marks cookies Secure, enables HSTS).
SECURE_COOKIES=false
# Set to true when running behind a reverse proxy (nginx, Caddy, load balancer).
TRUST_PROXY=false
# Where the SQLite database and uploaded photos are stored. Back this directory up.
DATA_DIR=./data

# First-run Main Administrator (only used when no admin exists yet).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# SMTP for invitation emails. If SMTP_HOST is empty, emails are stored in the
# admin "Email outbox" instead of being sent (useful for testing).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MANAGE Alumni Association Elections <elections@example.org>"
SMTP_REPLY_TO=
# Optional backup account (e.g. a second Gmail with its own app password), used automatically when the main one fails
SMTP2_USER=
SMTP2_PASS=
SMTP2_FROM=
MAIL_RATE_PER_MINUTE=120

# WhatsApp Business Platform (Meta Cloud API). Empty token = test mode (messages go to the outbox).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=voting_code
WHATSAPP_TEMPLATE_LANG=en
# Added to 10 digit numbers that have no country code
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Delivery status webhook: <PUBLIC_BASE_URL>/webhooks/whatsapp
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Twilio SMS. TWILIO_FROM = your Twilio number (+1...) or a Messaging Service SID (MG...). Empty = test mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# WhatsApp through Twilio (used instead of WHATSAPP_TOKEN when set): approved WhatsApp sender and Content Template SID
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
