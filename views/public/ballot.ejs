<%- include('../partials/public-top') %>
<div class="row between mb-1">
  <h1 class="mb-0">Your ballot</h1>
  <form method="post" action="/exit" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn ghost small" type="submit">Exit without voting</button></form>
</div>
<p class="muted"><%= election.name %>. For each contested post, select <strong>one candidate</strong> or choose <strong>Abstain</strong>. You will be able to review your choices before submitting.</p>

<% if (typeof incomplete !== 'undefined' && incomplete) { %>
  <div class="alert error" role="alert"><div><p>Please make a choice for every contested position. Choosing “Abstain for this post” counts as a choice.</p></div></div>
<% } %>
<div class="alert error" role="alert" id="incomplete-msg" hidden><div><p>Please make a choice for every contested position. Choosing “Abstain for this post” counts as a choice.</p></div></div>

<% if (!contested.length) { %>
  <div class="alert info"><div><p>There are no contested positions on this ballot.</p></div></div>
<% } else { %>
<form method="post" action="/ballot" id="ballot-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="ballot-progress" aria-live="polite">
    <div class="label"><span id="progress-label"><%= Object.keys(selections).length %> of <%= contested.length %> contested position<%= contested.length === 1 ? '' : 's' %> completed</span></div>
    <div class="progress"><span id="progress-bar" style="width: <%= (Object.keys(selections).length / contested.length * 100).toFixed(0) %>%"></span></div>
  </div>

  <% positions.forEach(function (p) { %>
    <% if (p.contested) { %>
    <fieldset class="position<%= errors[p.id] ? ' has-error' : '' %>" data-position="<%= p.id %>" id="pos-<%= p.id %>" style="border:0;padding:0;margin:0 0 1.75rem">
      <legend class="sr-only"><%= p.title %></legend>
      <header>
        <h2 aria-hidden="true"><%= p.title %></h2>
        <div class="muted small">Select one candidate, or abstain.<% if (p.description) { %> <%= p.description %><% } %></div>
      </header>
      <p class="position-error" role="alert"><%= errors[p.id] || ('Please select a candidate or choose to abstain for ' + p.title + '.') %></p>
      <div class="choices<%= p.candidates.length > 1 ? ' multi' : '' %>">
        <% p.candidates.forEach(function (c) { const checked = String(selections[p.id]) === String(c.id); %>
        <label class="choice<%= checked ? ' is-checked' : '' %>">
          <input type="radio" name="pos_<%= p.id %>" value="<%= c.id %>" <%= checked ? 'checked' : '' %> required>
          <%- include('../partials/photo', { cand: c, cls: 'photo' }) %>
          <span>
            <span class="name"><%= c.full_name %></span>
            <% if (c.batch) { %><span class="meta"><%= c.batch %></span><% } %>
            <span class="state">Selected</span>
          </span>
          <span class="tick" aria-hidden="true"></span>
        </label>
        <% }) %>
      </div>
      <div class="choices mt-1">
        <% const abst = selections[p.id] === 'abstain'; %>
        <label class="choice abstain<%= abst ? ' is-checked' : '' %>">
          <input type="radio" name="pos_<%= p.id %>" value="abstain" <%= abst ? 'checked' : '' %>>
          <span class="icon" aria-hidden="true">—</span>
          <span><span class="name">Abstain for this post</span><span class="meta">Do not vote for any candidate for <%= p.title %></span><span class="state">Selected</span></span>
          <span class="tick" aria-hidden="true"></span>
        </label>
      </div>
    </fieldset>
    <% } else if (p.unopposedCandidate) { %>
    <section class="position" aria-label="<%= p.title %> (unopposed)">
      <header><h2><%= p.title %></h2><div class="muted small">Declared elected unopposed — for information only, no vote needed.</div></header>
      <div class="unopposed-card">
        <%- include('../partials/photo', { cand: p.unopposedCandidate, cls: 'photo' }) %>
        <div><strong><%= p.unopposedCandidate.full_name %></strong> — Elected unopposed as <%= p.title %><% if (p.unopposedCandidate.batch) { %><div class="small muted"><%= p.unopposedCandidate.batch %></div><% } %></div>
      </div>
    </section>
    <% } %>
  <% }) %>

  <button type="submit" id="review-btn" class="btn large block">Review my choices</button>
  <p class="small muted center mt-1">Nothing is submitted yet. You will confirm on the next screen.</p>
</form>
<% } %>
<%- include('../partials/public-bottom') %>
