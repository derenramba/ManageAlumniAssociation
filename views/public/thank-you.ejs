<%- include('../partials/public-top') %>
<%- include('../partials/steps', { step: 4 }) %>
<section class="card center">
  <div class="success-mark" aria-hidden="true">✓</div>
  <h1>Thank you for voting</h1>
  <p class="turnout-figure">Your ballot has been successfully recorded in the <%= election.name %>.</p>
  <div class="receipt">Confirmation reference <strong><%= ballot.receipt %></strong></div>
  <p class="muted small mt-1 mb-0">Submitted <%= fmt(ballot.submitted_at) %></p>
</section>
<% if (showTurnout) { %><%- include('../partials/turnout', { turnout }) %><% } %>
<section class="card">
  <p class="mb-1">Your ballot is final and cannot be changed. Results will be published on this website after the election closes and the results have been reviewed.</p>
  <form method="post" action="/exit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary block" type="submit">Finish</button></form>
</section>
<%- include('../partials/public-bottom') %>
