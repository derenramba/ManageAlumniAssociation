<%- include('../partials/public-top') %>
<h1>Review your choices</h1>
<p class="muted"><%= election.name %></p>

<% if (error) { %><div class="alert error" role="alert"><div><p><%= error %></p></div></div><% } %>

<section class="card">
  <ul class="review-list">
  <% contested.forEach(function (p) { const sel = selections[p.id]; const cand = sel && sel !== 'abstain' ? p.candidates.find(c => String(c.id) === String(sel)) : null; %>
    <li>
      <span class="pos"><%= p.title %></span>
      <% if (cand) { %><span class="sel"><%= cand.full_name %></span><% } else { %><span class="sel abstain">Abstain</span><% } %>
    </li>
  <% }) %>
  <% unopposed.forEach(function (p) { if (!p.unopposedCandidate) return; %>
    <li><span class="pos"><%= p.title %></span><span class="muted"><%= p.unopposedCandidate.full_name %>, elected unopposed</span></li>
  <% }) %>
  </ul>
</section>

<p class="final-note mt-2">Once submitted, your choices cannot be changed.</p>

<div class="button-row mt-2">
  <a class="btn secondary large" href="/ballot">Edit choices</a>
  <form method="post" action="/ballot/submit" data-once style="flex:1 1 200px;display:flex">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="submission_token" value="<%= submissionToken %>">
    <button type="submit" class="btn large block" data-busy="Submitting your vote…" data-label="Submit my vote">Submit my vote</button>
  </form>
</div>
<%- include('../partials/public-bottom') %>
