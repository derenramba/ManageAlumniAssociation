<%- include('../partials/public-top') %>
<% const si = statusInfo(election); %>
<section class="card hero-premium">
  <div class="medallion"><img src="/static/img/logo.png" alt="MANAGE Alumni Association logo" width="112" height="112"></div>
  <span class="overline">Official election portal</span>
  <h1><%= election.name %></h1>
  <p class="tagline">Connecting MANAGE alumni worldwide to elect our association’s leadership.</p>
  <span class="status-pill <%= si.publicKey %>">Voting <%= si.publicKey === 'open' ? 'is open' : si.publicLabel.toLowerCase() %></span>
  <p class="hero-message">Wherever life has taken us, MANAGE continues to connect us. Your vote helps shape the future of our alumni community.</p>
  <dl class="dates">
    <div><dt>Voting opens</dt><dd><%= fmt(election.opens_at) %></dd></div>
    <div><dt>Voting closes</dt><dd><%= fmt(election.closes_at) %></dd></div>
  </dl>
</section>

<%- include('../partials/turnout', { turnout }) %>

<% if (votingOpen) { %>
<section class="card code-card" aria-labelledby="code-h">
  <span class="overline">Step 1</span>
  <h2 id="code-h">Enter your voting code</h2>
  <p class="muted">You will find your personal code in your invitation email.</p>
  <% if (error) { %>
    <div class="alert <%= errorKind === 'invalid' || errorKind === 'revoked' || errorKind === 'rate' ? 'error' : 'warning' %>" role="alert" id="code-error"><div><p><%= error %></p></div></div>
  <% } %>
  <form method="post" action="/vote" class="code-entry" data-once autocomplete="off" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="code" class="sr-only">Voting code</label>
      <input class="code-input" type="text" id="code" name="code" inputmode="text" autocapitalize="characters" autocomplete="one-time-code" spellcheck="false"
             placeholder="XXXX XXXX XXXX XXXX" maxlength="40" required value="<%= codeValue %>" <% if (error) { %>aria-describedby="code-error" aria-invalid="true"<% } %>>
      <div class="hint center">Tip: copy the code from the email and paste it here.</div>
    </div>
    <button type="submit" class="btn large block" data-busy="Checking your code…">Enter to vote →</button>
  </form>
</section>
<% } else if (si.publicKey === 'published') { %>
<section class="card">
  <div class="alert info"><div><p>Voting has closed and the official results have been published.</p></div></div>
  <a class="btn large block" href="/results">View official results</a>
</section>
<% } else { %>
<section class="card"><div class="alert <%= si.publicKey === 'suspended' ? 'warning' : 'info' %> mb-0" role="status"><div><p><%= notOpenMessage %></p></div></div></section>
<% } %>

<% if (election.description) { %><section class="card">
  <h2>About this Election</h2>
  <div class="about-text">
  <% String(election.description).replace(/\r\n?/g, '\n').trim().split(/\n\s*\n+/).forEach(function (para) { %>
    <p><% para.split('\n').forEach(function (line, i) { %><% if (i) { %><br><% } %><%= line.trim() %><% }) %></p>
  <% }) %>
  </div>
</section><% } %>

<section class="card">
  <h2>How to vote</h2>
  <ol class="how">
    <li><span class="n" aria-hidden="true">1</span><div><strong>Enter your voting code</strong><span class="t">Enter the personal code sent to your registered email address or mobile number.</span></div></li>
    <li><span class="n" aria-hidden="true">2</span><div><strong>Choose your candidates</strong><span class="t">Select one candidate for each contested post, or choose “Abstain for this post”. Posts marked “Elected unopposed” do not require a vote.</span></div></li>
    <li><span class="n" aria-hidden="true">3</span><div><strong>Review and submit your ballot</strong><span class="t">Check your choices, then select “Submit my vote”. You can submit only once, and your choices cannot be changed afterwards.</span></div></li>
  </ol>
</section>

<% if (unopposed.length) { %>
<section class="card">
  <h2>Elected unopposed</h2>
  <p class="muted">These posts have been declared elected unopposed and are shown for information only.</p>
  <div class="stack">
  <% unopposed.forEach(function (p) { %>
    <div class="unopposed-card">
      <%- include('../partials/photo', { cand: p.unopposedCandidate, cls: 'photo' }) %>
      <div><strong><%= p.unopposedCandidate.full_name %></strong><div class="small muted"><%= p.title %><% if (p.unopposedCandidate.batch) { %> · <%= p.unopposedCandidate.batch %><% } %></div><span class="badge success">Elected unopposed</span></div>
    </div>
  <% }) %>
  </div>
</section>
<% } %>

<%- include('../partials/public-bottom') %>
