<%- include('../partials/admin-top') %>
<div class="page-head"><div><h1>Turnout</h1><p>Turnout = accepted ballots ÷ approved eligible voters. Candidate totals are not shown here.</p></div></div>
<div class="stats">
  <div class="stat"><div class="k">Eligible voters</div><div class="v"><%= t.eligible.toLocaleString('en-IN') %></div></div>
  <div class="stat"><div class="k">Ballots submitted</div><div class="v"><%= t.voted.toLocaleString('en-IN') %></div></div>
  <div class="stat"><div class="k">Voters remaining</div><div class="v"><%= t.remaining.toLocaleString('en-IN') %></div></div>
  <div class="stat"><div class="k">Turnout</div><div class="v"><%= t.pctLabel %></div></div>
</div>
<section class="card"><div class="progress" style="height:22px" role="progressbar" aria-valuenow="<%= t.pct.toFixed(1) %>" aria-valuemin="0" aria-valuemax="100"><span style="width: <%= Math.min(100, t.pct).toFixed(1) %>%"></span></div>
  <p class="mt-1 mb-0"><strong><%= t.voted %></strong> of <strong><%= t.eligible %></strong> eligible alumni have voted — <strong><%= t.pctLabel %></strong> turnout</p></section>

<div class="grid-2 mt-2">
<section class="card"><h2>By batch</h2>
  <div class="table-wrap"><table class="data"><thead><tr><th>Batch</th><th class="num">Eligible</th><th class="num">Voted</th><th class="num">Turnout</th></tr></thead><tbody>
  <% byBatch.forEach(function (b) { %><tr><td><%= b.batch %></td><td class="num"><%= b.eligible %></td><td class="num"><%= b.voted %></td><td class="num"><%= b.eligible ? (b.voted / b.eligible * 100).toFixed(1) : '0.0' %>%</td></tr><% }) %>
  </tbody></table></div></section>
<section class="card"><h2>Ballots per hour (IST)</h2>
  <% if (!byDay.length) { %><p class="muted">No ballots yet.</p><% } else { const max = Math.max(...byDay.map(d => d.n)); %>
  <div class="chart-bars" role="img" aria-label="Ballots submitted per hour"><% byDay.forEach(function (d) { %><span style="height: <%= (d.n / max * 100).toFixed(0) %>%" title="<%= d.hour.replace('T',' ').replace(' ', ' ') %>:00 — <%= d.n %>"></span><% }) %></div>
  <p class="small muted mt-1 mb-0"><%= byDay[0].hour %>:00 → <%= byDay[byDay.length-1].hour %>:00 · peak <%= max %> per hour</p><% } %>
</section>
</div>

<section class="card mt-2">
  <div class="card-header"><h2>Voters</h2>
    <div class="tabs mb-0"><% [['all','All eligible'],['voted','Voted'],['not_voted','Not voted']].forEach(function ([v,l]) { %><a href="?filter=<%= v %>" class="<%= filter === v ? 'active' : '' %>"><%= l %></a><% }) %></div></div>
  <form method="get" class="filters"><input type="hidden" name="filter" value="<%= filter %>"><div class="field search"><label for="q">Search</label><input type="search" id="q" name="q" value="<%= q %>"></div><button class="btn secondary">Search</button></form>
  <div class="table-wrap"><table class="data"><thead><tr><th>Name</th><th>Batch</th><th>Email</th><th>Status</th><th>Submitted at</th></tr></thead><tbody>
  <% voters.forEach(function (v) { %><tr><td><a href="/admin/voters/<%= v.id %>"><%= v.full_name %></a></td><td class="small"><%= v.batch || '—' %></td><td class="small"><%= v.email || '—' %></td><td><% if (v.submitted_at) { %><span class="badge success dot">Voted</span><% } else { %><span class="badge neutral">Not voted</span><% } %></td><td class="small"><%= v.submitted_at ? fmtShort(v.submitted_at) : '—' %></td></tr><% }) %>
  <% if (!voters.length) { %><tr><td colspan="5" class="muted">No voters.</td></tr><% } %>
  </tbody></table></div>
  <% if (voters.length === 500) { %><p class="small muted">Showing first 500. Use search to narrow.</p><% } %>
</section>
<%- include('../partials/admin-bottom') %>
