<%- include('../partials/admin-top') %>
<div class="page-head"><div><h1><%= labels.title %></h1></div><a class="btn secondary" href="/admin/invitations">Cancel</a></div>
<% if (!list.length) { %>
  <div class="alert info"><div>There are no voters to send to in this selection. Voters are only included if they are eligible, have a valid email and an active (unused) voting code, and are not already queued.</div></div>
  <a class="btn secondary" href="/admin/invitations">Back to invitations</a>
<% } else { %>
<section class="confirm-box" style="max-width:820px">
  <h2 class="mt-0">You are about to <%= labels.verb %> <%= list.length.toLocaleString('en-IN') %> eligible voter<%= list.length === 1 ? '' : 's' %>.</h2>
  <ul>
    <li>Subject: <strong><%= subject %></strong></li>
    <li>Each email contains that voter's own voting code — no new codes are created.</li>
    <% if (resends) { %><li><strong><%= resends %></strong> of these voter(s) have already been sent an invitation; this will be recorded as a <strong>resend</strong>.</li><% } %>
    <% if (mailMode !== 'smtp') { %><li>Outbox mode: messages will be stored in the Email outbox, not delivered.</li><% } %>
  </ul>
  <form method="post" action="/admin/invitations/send" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="mode" value="<%= mode %>">
    <% ids.forEach(function (id) { %><input type="hidden" name="ids" value="<%= id %>"><% }) %>
    <label class="check mb-2"><input type="checkbox" name="confirm" value="yes" required> <span>I have previewed the invitation and confirm sending.</span></label>
    <div class="row"><a class="btn secondary" href="/admin/invitations">Cancel</a><button class="btn" type="submit">Confirm and Send</button></div>
  </form>
</section>
<details class="mt-2"><summary>Show recipients (<%= list.length %>)</summary>
  <div class="table-wrap mt-1"><table class="data"><thead><tr><th>Name</th><th>Email</th><th>Previously sent</th></tr></thead><tbody>
  <% list.slice(0, 1000).forEach(function (v) { %><tr><td><%= v.full_name %></td><td class="small"><%= v.email %></td><td class="num"><%= v.sent_count %></td></tr><% }) %>
  </tbody></table></div>
</details>
<% } %>
<%- include('../partials/admin-bottom') %>
