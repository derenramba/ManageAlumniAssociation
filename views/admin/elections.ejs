<%- include('../partials/admin-top') %>
<div class="page-head"><div><h1>Elections</h1><p>Each election has its own positions, candidates, voter register, codes and results. The current election is shown on the voting website.</p></div></div>
<% if (rows.length) { %>
<div class="table-wrap mb-2"><table class="data">
  <thead><tr><th>Election</th><th>Status</th><th>Opens</th><th>Closes</th><th class="num">Eligible</th><th class="num">Ballots</th><th></th></tr></thead>
  <tbody>
  <% rows.forEach(function (e) { const si = statusInfo(e); %>
    <tr>
      <td><strong><%= e.name %></strong><% if (e.term) { %><div class="small muted"><%= e.term %></div><% } %><% if (e.is_demo) { %> <span class="badge warning">Demo</span><% } %></td>
      <td><span class="badge dot <%= si.tone %>"><%= si.label %></span></td>
      <td class="small"><%= fmtShort(e.opens_at) %></td><td class="small"><%= fmtShort(e.closes_at) %></td>
      <td class="num"><%= e.eligible %></td><td class="num"><%= e.ballots %></td>
      <td><% if (e.id === currentId) { %><span class="badge success">Current</span><% } else if (can('manage_election')) { %>
        <form method="post" action="/admin/elections/<%= e.id %>/select" class="inline-form" data-confirm="Make this the current election shown on the voting website?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn secondary small">Make current</button></form><% } %></td>
    </tr>
  <% }) %>
  </tbody></table></div>
<% } else { %><div class="alert info"><div>No elections yet. Create the first one below.</div></div><% } %>

<% if (can('manage_election')) { %>
<section class="card">
  <h2>Create a new election</h2>
  <form method="post" action="/admin/elections" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label for="name">Election name</label><input type="text" id="name" name="name" required value="MANAGE Alumni Association Election"></div>
      <div class="field"><label for="term">Term / year</label><input type="text" id="term" name="term" placeholder="e.g. 2026–2028"></div>
      <div class="field"><label for="copy">Positions</label><select id="copy" name="copy_positions_from"><option value="">Standard positions (President … Treasurer)</option><% rows.forEach(function (e) { %><option value="<%= e.id %>">Copy positions from: <%= e.name %></option><% }) %></select></div>
    </div>
    <button class="btn" type="submit">Create election</button>
  </form>
</section>
<% } %>
<%- include('../partials/admin-bottom') %>
