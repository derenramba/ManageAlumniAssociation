<%- include('../partials/admin-top') %>
<div class="page-head"><div><h1>Import voters</h1><p>Upload a CSV or Excel (.xlsx) file. You will see a preview with duplicates and problems highlighted before anything is saved.</p></div><a class="btn secondary" href="/admin/import/template.csv">Download CSV template</a></div>

<% if (!preview) { %>
<section class="card" style="max-width:820px">
  <form method="post" action="/admin/import" enctype="multipart/form-data" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label for="file">Voter file</label><input type="file" id="file" name="file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" required>
      <div class="hint">First row must contain column headings. Recognised columns: <strong>Voter ID</strong> (or Member ID), <strong>Full Name</strong> (or Name, or First/Last name), <strong>Email</strong>, <strong>Mobile</strong> (or Phone), <strong>WhatsApp</strong>, <strong>Batch</strong> (or Year).</div></div>
    <button class="btn" type="submit">Upload and preview</button>
  </form>
</section>
<section class="card" style="max-width:820px">
  <h2>How repeat imports work</h2>
  <ul class="mb-0">
    <li>Each person keeps one stable voter record. Rows are matched to existing voters by <strong>Voter ID</strong>, or by the same name with the same email (or mobile).</li>
    <li>Matched rows <strong>update</strong> contact details — they never create a second voter or a second voting entitlement.</li>
    <li>Shared emails or phone numbers are flagged as <em>possible duplicates</em> for review, but nobody is disqualified automatically.</li>
    <li>Missing email or phone is allowed and reported.</li>
  </ul>
</section>
<% } else { %>
<section class="card">
  <h2>Preview: <%= preview.filename %></h2>
  <div class="stats">
    <div class="stat"><div class="k">New voters</div><div class="v"><%= preview.create %></div></div>
    <div class="stat"><div class="k">Update existing</div><div class="v"><%= preview.update %></div></div>
    <div class="stat"><div class="k">Skipped (errors)</div><div class="v"><%= preview.skip %></div></div>
    <div class="stat"><div class="k">Rows with warnings</div><div class="v"><%= preview.warnings %></div></div>
  </div>
  <form method="post" action="/admin/import/<%= preview.id %>/apply" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <fieldset><legend>Eligibility for new voters</legend>
      <label class="check"><input type="radio" name="eligibility" value="pending" checked> <span>Pending review (recommended — review duplicates first)</span></label>
      <label class="check mt-1"><input type="radio" name="eligibility" value="eligible"> <span>Eligible immediately</span></label>
    </fieldset>
    <% if (listApproved) { %><div class="field"><label for="amend_reason">Reason for amending the approved voter list (required)</label><input type="text" id="amend_reason" name="amend_reason" required></div><% } %>
    <div class="row"><button class="btn" type="submit">Import <%= preview.create + preview.update %> row(s)</button><a class="btn ghost" href="/admin/import">Cancel</a></div>
  </form>
</section>
<div class="table-wrap mt-2"><table class="data">
  <thead><tr><th>Row</th><th>Action</th><th>Voter ID</th><th>Name</th><th>Email</th><th>Mobile</th><th>Batch</th><th>Issues</th></tr></thead>
  <tbody>
  <% preview.rows.forEach(function (r) { %>
    <tr>
      <td class="num"><%= r.row %></td>
      <td><span class="badge <%= r.action === 'create' ? 'success' : r.action === 'update' ? 'info' : 'error' %>"><%= r.action === 'create' ? 'New' : r.action === 'update' ? 'Update ' + (r.matchRef || '') : 'Skip' %></span></td>
      <td class="mono small"><%= r.voter_ref || '(auto)' %></td><td><%= r.full_name %></td><td class="small"><%= r.email %></td><td class="small"><%= r.mobile %></td><td class="small"><%= r.batch %></td>
      <td class="small"><% r.errors.forEach(function (x) { %><div class="badge error"><%= x %></div> <% }) %><% r.warnings.forEach(function (x) { %><div class="badge warning"><%= x %></div> <% }) %></td>
    </tr>
  <% }) %>
  </tbody></table></div>
<% } %>

<% if (history.length) { %>
<section class="card mt-2"><h2>Recent imports</h2>
  <ul class="mb-0"><% history.forEach(function (h) { %><li><%= fmtShort(h.applied_at) %> — <%= h.filename %> by <%= h.admin_name %></li><% }) %></ul>
</section>
<% } %>
<%- include('../partials/admin-bottom') %>
