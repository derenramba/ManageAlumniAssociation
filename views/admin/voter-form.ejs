<%- include('../partials/admin-top') %>
<% const voted = !!voter.ballot_id; %>
<div class="page-head"><div><h1><%= isNew ? 'Add voter' : 'Edit voter' %></h1><% if (!isNew) { %><p class="mono"><%= voter.voter_ref %></p><% } %></div><a class="btn secondary" href="<%= isNew ? '/admin/voters' : '/admin/voters/' + voter.id %>">Cancel</a></div>
<% if (voted) { %><div class="alert info"><div><strong>Ballot already submitted — voting entitlement locked.</strong> Only contact details (email, mobile, WhatsApp) and notes can be corrected.</div></div><% } %>
<section class="card" style="max-width:820px">
  <form method="post" action="<%= isNew ? '/admin/voters' : '/admin/voters/' + voter.id %>" data-once>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-grid">
      <div class="field"><label for="voter_ref">Voter ID</label><input type="text" id="voter_ref" name="voter_ref" value="<%= voter.voter_ref || '' %>" <%= voted ? 'readonly' : '' %> placeholder="<%= isNew ? 'Leave blank to assign automatically' : '' %>"><div class="hint">Membership / alumni ID. Must be unique.</div></div>
      <div class="field"><label for="full_name">Full name</label><input type="text" id="full_name" name="full_name" value="<%= voter.full_name || '' %>" required <%= voted ? 'readonly' : '' %>></div>
      <div class="field"><label for="email">Email</label><input type="email" id="email" name="email" value="<%= voter.email || '' %>"><div class="hint">Optional — voters without email remain eligible; deliver their code externally.</div></div>
      <div class="field"><label for="mobile">Mobile</label><input type="tel" id="mobile" name="mobile" value="<%= voter.mobile || '' %>"></div>
      <div class="field"><label for="whatsapp">WhatsApp number</label><input type="tel" id="whatsapp" name="whatsapp" value="<%= voter.whatsapp || '' %>"></div>
      <div class="field"><label for="batch">Batch / year</label><input type="text" id="batch" name="batch" value="<%= voter.batch || '' %>" <%= voted ? 'readonly' : '' %>></div>
    </div>
    <div class="field"><label for="notes">Internal notes</label><textarea id="notes" name="notes" rows="2"><%= voter.notes || '' %></textarea></div>
    <% if (isNew) { %>
      <fieldset><legend>Eligibility</legend>
        <label class="check"><input type="radio" name="eligibility" value="pending" checked> <span>Pending review</span></label>
        <label class="check mt-1"><input type="radio" name="eligibility" value="eligible"> <span>Eligible</span></label>
        <label class="check mt-1"><input type="radio" name="eligibility" value="ineligible"> <span>Ineligible</span></label>
        <% if (listApproved) { %><div class="field mt-1" data-show-when="eligibility=eligible"><label for="amend_reason">Reason for adding to the approved electorate (required)</label><input type="text" id="amend_reason" name="amend_reason"></div><% } %>
      </fieldset>
    <% } %>
    <button class="btn" type="submit"><%= isNew ? 'Add voter' : 'Save changes' %></button>
  </form>
</section>
<%- include('../partials/admin-bottom') %>
